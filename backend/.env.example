# Copy to `.env` and adjust for your target. Run with `npm run dev`.
# All values are optional; defaults (in app.js) suit a real PLC at 192.168.1.1.

# --- OPC UA (PLC) ---
OPCUA_ENDPOINT=opc.tcp://127.0.0.1:4840   # virtual core; real PLC = its Ethernet IP
OPCUA_SECURITY=sign-encrypt               # sign-encrypt | none  (virtual core needs sign-encrypt)
# OPCUA_BASE_NODE=ns=2;s=plc/app/Application/sym/MAIN/_userInput/UserInput
# OPCUA_USER=boschrexroth
# OPCUA_PASSWORD=boschrexroth

# --- InfluxDB historian ---
INFLUX_URL=https://127.0.0.1:8443/influxdb   # virtual core serves HTTPS on :8443
# INFLUX_ORG=eed67067a388a208
# INFLUX_TOKEN=<your-influx-token>

# --- Server ---
# PORT=3000
